# Crowny Material Preset
# Built-in toon look: hard bands, black outlines, neutral specular and rim.
Version: 1
Name: Classic
Target: Toon
Parameters:
  - {Name: tint, Type: Color, Value: [1, 1, 1, 1]}
  - {Name: toonSpecularColor, Type: Color, Value: [1, 1, 1, 1]}
  - {Name: toonRimColor, Type: Color, Value: [1, 1, 1, 1]}
  - {Name: toonRampStrength, Type: Float, Value: 0}
  - {Name: toonRampOffset, Type: Float, Value: 0}
  - {Name: toonMatcapStrength, Type: Float, Value: 0}
  - {Name: toonMatcapRotation, Type: Float, Value: 0}
  - {Name: outlineColor, Type: Color, Value: [0, 0, 0, 1]}
  - {Name: thickness, Type: Float, Value: 1}
  - {Name: toonSilhouetteWidth, Type: Float, Value: 1}
  - {Name: bands, Type: Float, Value: 3}
  - {Name: specularSize, Type: Float, Value: 0.5}
  - {Name: specularSmoothness, Type: Float, Value: 1}
  - {Name: shadowBrightness, Type: Float, Value: 0.2}
  - {Name: toonShadowColor, Type: Color, Value: [0.2, 0.22, 0.3, 1]}
  - {Name: toonBandSmoothness, Type: Float, Value: 0.08}
  - {Name: toonSpecularThreshold, Type: Float, Value: 0.8}
  - {Name: toonSpecularSmoothness, Type: Float, Value: 0.05}
  - {Name: toonSpecularStrength, Type: Float, Value: 0.5}
  - {Name: rimPower, Type: Float, Value: 3}
  - {Name: rimThreshold, Type: Float, Value: 0.5}
  - {Name: toonRimSmoothness, Type: Float, Value: 0.08}
  - {Name: toonRimStrength, Type: Float, Value: 0.5}
  - {Name: toonRimShadowMask, Type: Float, Value: 0.75}
  - {Name: toonIndirectStrength, Type: Float, Value: 0.5}
  - {Name: toonPatternScale, Type: Float, Value: 16}
  - {Name: toonPatternStrength, Type: Float, Value: 0}
  - {Name: toonPatternSmoothness, Type: Float, Value: 0.1}
  - {Name: toonPatternDistanceFade, Type: Float, Value: 50}
  - {Name: toonPatternMapping, Type: Int, Value: 0}
  - {Name: toonOutlineDepthThreshold, Type: Float, Value: 0.002}
  - {Name: toonOutlineNormalThreshold, Type: Float, Value: 0.2}
  - {Name: toonOutlineDistanceFade, Type: Float, Value: 100}
