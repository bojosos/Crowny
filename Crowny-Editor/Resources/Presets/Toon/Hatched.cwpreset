# Crowny Material Preset
# Built-in toon look: dark ink outlines with a procedural hatching pattern in the shadows.
Version: 1
Name: Hatched
Target: Toon
Parameters:
  - {Name: tint, Type: Color, Value: [1, 1, 1, 1]}
  - {Name: toonSpecularColor, Type: Color, Value: [1, 1, 1, 1]}
  - {Name: toonRampStrength, Type: Float, Value: 0}
  - {Name: toonRampOffset, Type: Float, Value: 0}
  - {Name: toonMatcapStrength, Type: Float, Value: 0}
  - {Name: toonMatcapRotation, Type: Float, Value: 0}
  - {Name: outlineColor, Type: Color, Value: [0.015, 0.015, 0.02, 1]}
  - {Name: thickness, Type: Float, Value: 1.25}
  - {Name: toonSilhouetteWidth, Type: Float, Value: 1.25}
  - {Name: bands, Type: Float, Value: 3}
  - {Name: specularSize, Type: Float, Value: 0.82}
  - {Name: specularSmoothness, Type: Float, Value: 1.25}
  - {Name: shadowBrightness, Type: Float, Value: 0.12}
  - {Name: toonShadowColor, Type: Color, Value: [0.12, 0.13, 0.18, 1]}
  - {Name: toonBandSmoothness, Type: Float, Value: 0.03}
  - {Name: toonSpecularThreshold, Type: Float, Value: 0.82}
  - {Name: toonSpecularSmoothness, Type: Float, Value: 0.03}
  - {Name: toonSpecularStrength, Type: Float, Value: 0.15}
  - {Name: toonRimColor, Type: Color, Value: [0.8, 0.85, 1, 1]}
  - {Name: rimPower, Type: Float, Value: 4}
  - {Name: rimThreshold, Type: Float, Value: 0.6}
  - {Name: toonRimSmoothness, Type: Float, Value: 0.05}
  - {Name: toonRimStrength, Type: Float, Value: 0.25}
  - {Name: toonRimShadowMask, Type: Float, Value: 0.9}
  - {Name: toonIndirectStrength, Type: Float, Value: 0.35}
  - {Name: toonPatternScale, Type: Float, Value: 24}
  - {Name: toonPatternStrength, Type: Float, Value: 0.7}
  - {Name: toonPatternSmoothness, Type: Float, Value: 0.04}
  - {Name: toonPatternDistanceFade, Type: Float, Value: 80}
  - {Name: toonPatternMapping, Type: Int, Value: 3}
  - {Name: toonOutlineDepthThreshold, Type: Float, Value: 0.0015}
  - {Name: toonOutlineNormalThreshold, Type: Float, Value: 0.15}
  - {Name: toonOutlineDistanceFade, Type: Float, Value: 160}
