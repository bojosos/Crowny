shader image_texture(
    string image = "" [[ string label = "Image" ]],
    string detail = "" [[ string label = "Detail image" ]],
    float scale = 1.0,
    float blend = 0.35,
    output color Cout = 0)
{
    float alpha = 0;
    color base = texture(image, u * scale, v * scale, "alpha", alpha);
    color overlay = texture(detail, u * 2 + 0.13, v * 3 - 0.17,
                            2 * Dx(u), 3 * Dx(v), 2 * Dy(u), 3 * Dy(v));
    float channel = texture(detail, u, v);
    if (u > 0.5)
        base = texture(image, u * scale + 0.25, v * scale, "alpha", alpha);
    Cout = mix(base, overlay, blend) * alpha * (0.5 + 0.5 * channel);
}
